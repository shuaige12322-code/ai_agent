# Claude API Configuration
CLAUDE_API_KEY=your_claude_api_key_here

# Environment (development or production)
ENVIRONMENT=development

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Logging
LOG_LEVEL=DEBUG

# Memory System
MEMORY_ENABLED=true
MAX_MEMORIES=10
MEMORY_TTL_DAYS=30

# RAG Configuration
RAG_ENABLED=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.5
